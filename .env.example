# Development-only example; choose your own local password before starting PostgreSQL.
POSTGRES_USER=fitness
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=fitness
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
API_PORT=8000

APP_ENV=development
LOG_LEVEL=INFO
DATABASE_TIMEOUT_SECONDS=2

# Optional SQLAlchemy URL override; encode reserved characters in URL credentials.
# DATABASE_URL=postgresql+asyncpg://user:password@127.0.0.1:5432/fitness

# Isolated integration-test service (separate database/container/volume).
TEST_POSTGRES_PORT=55432
# Required only when running PostgreSQL integration tests; see README.md.
# TEST_DATABASE_URL=postgresql+asyncpg://fitness_test:fitness_test_local@127.0.0.1:55432/fitness_test
