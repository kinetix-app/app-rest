# Development-only example; choose your own local password before starting PostgreSQL.
POSTGRES_USER=fitness
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=fitness
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
API_PORT=8000
# Set to 0.0.0.0 only to let physical devices on your LAN reach the API.
# API_BIND_ADDRESS=0.0.0.0

APP_ENV=development
LOG_LEVEL=INFO
DATABASE_TIMEOUT_SECONDS=2
CORS_ALLOWED_ORIGINS=["http://localhost:8081"]

# Optional SQLAlchemy URL override; encode reserved characters in URL credentials.
# DATABASE_URL=postgresql+asyncpg://user:password@127.0.0.1:5432/fitness

# Isolated integration-test service (separate database/container/volume).
TEST_POSTGRES_PORT=55432
# Required only when running PostgreSQL integration tests; see README.md.
# TEST_DATABASE_URL=postgresql+asyncpg://fitness_test:fitness_test_local@127.0.0.1:55432/fitness_test

# Optional local SonarQube (see README.md); SONAR_TOKEN is created in the UI on first login.
SONAR_PORT=9000
# SONAR_TOKEN=create-a-token-in-the-local-sonarqube-ui
# SonarCloud issue retrieval (separate token from the local SonarQube token).
# SONAR_CLOUD_TOKEN=create-a-sonarcloud-token
SONAR_ORGANIZATION=kinetix-app

# Clerk: complete docs/authentication.md before using protected routes.
# Use the exact Frontend API origin of your Clerk development instance.
# CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# Backend API secret from the same Clerk instance (never put this in the frontend).
# CLERK_SECRET_KEY=sk_test_...
# An empty allowlist accepts native tokens without azp; present azp is always checked.
CLERK_AUTHORIZED_PARTIES=[]
# Optional only if your session-token contract has an aud claim:
# CLERK_AUDIENCE=your-api-audience
CLERK_CLOCK_SKEW_SECONDS=5

# Non-production defaults to Basic; production defaults to Clerk.
# Leave blank normally. Set clerk to test Clerk outside production.
AUTH_MODE=
# Configure local accounts before signing in (no built-in credentials):
BASIC_AUTH_USERS={}
# Example: BASIC_AUTH_USERS={"alice@example.test":"choose-a-local-password"}
# Production rejects AUTH_MODE=basic.

# Local Azure Blob Storage emulator (public development credentials, not Azure secrets).
AZURITE_PORT=10000
# AZURITE_BIND_ADDRESS=0.0.0.0 # Only for a physical device on a trusted LAN.
AZURE_STORAGE_ACCOUNT_NAME=kinetixlocal
AZURE_STORAGE_ACCOUNT_URL=http://127.0.0.1:10000/kinetixlocal
AZURE_STORAGE_ACCOUNT_KEY=a2luZXRpeC1sb2NhbC1kZXZlbG9wbWVudC1vbmx5LWtleQ==
AZURE_STORAGE_CONTAINER=exercises
# Always private and separate from the exercise container.
AZURE_STORAGE_PROFILE_CONTAINER=profile-pictures
# Account root reachable by the client, without a container, query string or SAS.
AZURE_STORAGE_MEDIA_BASE_URL=http://127.0.0.1:10000/kinetixlocal
AZURE_STORAGE_LOCAL_PUBLIC_READ=true
AZURE_STORAGE_TIMEOUT_SECONDS=30
# Packaged API account URL; set explicitly when using a real Azure storage account.
# AZURE_STORAGE_COMPOSE_ACCOUNT_URL=https://your-account.blob.core.windows.net
# Production: HTTPS URLs + real backend-only account key; LOCAL_PUBLIC_READ=false.
# No storage client is created by a host API when all four account/URL/key settings are absent.
